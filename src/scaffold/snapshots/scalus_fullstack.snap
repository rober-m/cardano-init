=== protocol/Justfile ===
# Protocol component (Scalus, fullstack: on-chain + off-chain)
# Part of snap-project
#
# One unified Scala 3 / sbt build for BOTH the on-chain gift-card validators and
# the off-chain transaction building. The two halves share types directly (no
# blueprint round-trip between them) — that shared build is the whole point of
# the fullstack layout. `build` still writes ../blueprint/plutus.json so the
# other components (devnet, formal-methods, infra) can consume it.
#
# Where transactions go is decided by the shared ../.env (see .env.example):
#   • INDEXER_URL set (a local devnet, e.g. Yaci DevKit's `just dev`) → that
#     devnet, with its built-in test wallet. No Blockfrost key needed.
#   • INDEXER_URL absent → Blockfrost (needs BLOCKFROST_API_KEY + MNEMONIC).

# Compile the Scala sources and write the CIP-57 blueprint to ../blueprint/plutus.json.
build:
    @sbt "runMain app.genBlueprint ../blueprint/plutus.json"

# Unit tests on the built-in emulator — no blockchain, milliseconds per test.
test:
    @sbt test

# Run the gift-card REST API against whatever ../.env points at (local devnet or
# Blockfrost). Swagger UI at http://localhost:8088/docs. Long-running: Ctrl-C.
dev:
    sbt "runMain app.start"

clean:
    @sbt clean

=== protocol/build.sbt ===
val scalusVersion = "0.18.2"

resolvers += Resolver.sonatypeCentralSnapshots

// Latest Scala 3 LTS version
ThisBuild / scalaVersion := "3.3.8"

ThisBuild / scalacOptions ++= Seq("-feature", "-deprecation", "-unchecked")

// Scala 3.3.x LTS still uses sun.misc.Unsafe in LazyVals, which JDK 24+ warns about.
// Fork tests and allow the deprecated memory-access methods to silence the warning.
// The flag only exists on JDK 23+, so guard it to avoid breaking older JDKs.
ThisBuild / Test / fork := true
ThisBuild / Test / javaOptions ++= {
    val javaVersion = System.getProperty("java.specification.version").toInt
    if (javaVersion >= 23) Seq("--sun-misc-unsafe-memory-access=allow") else Seq.empty
}

// The Scalus compiler plugin turns @Compile-annotated Scala into Plutus Core.
addCompilerPlugin("org.scalus" % "scalus-plugin" % scalusVersion cross CrossVersion.full)

lazy val root = (project in file("."))
    .enablePlugins(ScalusSbtPlugin)
    .settings(
      name := "snap-project",
      libraryDependencies ++= Seq(
        // Scalus
        "org.scalus" %% "scalus" % scalusVersion,
        "org.scalus" %% "scalus-cardano-ledger" % scalusVersion,
        // Tapir for the REST API + Swagger UI
        "com.softwaremill.sttp.tapir" %% "tapir-netty-server-sync" % "1.13.22",
        "com.softwaremill.sttp.tapir" %% "tapir-swagger-ui-bundle" % "1.13.22",
        // Logging (scribe is used by Scalus; declared explicitly to configure the format)
        "com.outr" %% "scribe" % "3.19.0",
        "org.slf4j" % "slf4j-simple" % "2.0.18"
      ),
      libraryDependencies ++= Seq(
        "org.scalus" %% "scalus-testkit" % scalusVersion,
        "org.scalatest" %% "scalatest" % "3.2.20" % Test,
        "org.scalatestplus" %% "scalacheck-1-18" % "3.2.19.0" % Test,
        "org.scalacheck" %% "scalacheck" % "1.19.0" % Test
      )
    )

